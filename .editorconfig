# dotnet_diagnostic.RCS0042.severity = warning
# dotnet_diagnostic.RCS0045.severity = warning
# dotnet_diagnostic.RCS0046.severity = warning
# dotnet_diagnostic.RCS0050.severity = warning
# dotnet_diagnostic.RCS0051.severity = warning
# dotnet_diagnostic.RCS0052.severity = warning
# dotnet_diagnostic.RCS0053.severity = warning
# dotnet_diagnostic.RCS0054.severity = warning
# dotnet_diagnostic.RCS0055.severity = warning
# dotnet_diagnostic.RCS0056.severity = warning
# dotnet_diagnostic.RCS0057.severity = warning
# dotnet_diagnostic.RCS0058.severity = warning
# dotnet_diagnostic.RCS0059.severity = warning
# dotnet_diagnostic.RCS0060.severity = warning
# dotnet_diagnostic.RCS0061.severity = warning
# dotnet_diagnostic.RCS0062.severity = disabled
# dotnet_diagnostic.RCS0063.severity = warning
# dotnet_diagnostic.RCS1001.severity = warning
# dotnet_diagnostic.RCS1002.severity = disabled
# dotnet_diagnostic.RCS1003.severity = warning
# dotnet_diagnostic.RCS1004.severity = disabled
# dotnet_diagnostic.RCS1005.severity = warning
# dotnet_diagnostic.RCS1006.severity = warning
# dotnet_diagnostic.RCS1007.severity = warning
# dotnet_diagnostic.RCS1013.severity = warning
# dotnet_diagnostic.RCS1014.severity = warning

roslynator_block_braces_style = multi_line
roslynator_blank_line_between_using_directives = never
roslynator_binary_operator_new_line = before
roslynator_conditional_operator_new_line = before
roslynator_arrow_token_new_line = before
roslynator_equals_token_new_line = before
roslynator_max_line_length = 1024
roslynator_tab_length = 4
roslynator_new_line_at_end_of_file = true
roslynator_null_conditional_operator_new_line = before
roslynator_blank_line_after_file_scoped_namespace_declaration = true
roslynator_blank_line_between_switch_sections = include
roslynator_arrow_token_new_line = before
roslynator_array_creation_type_style = implicit

# Existing compiler diagnostics. Raise one rule at a time as its findings are fixed.
dotnet_diagnostic.CS0162.severity = suggestion
dotnet_diagnostic.CS0168.severity = suggestion
dotnet_diagnostic.CS0618.severity = suggestion
dotnet_diagnostic.CS0659.severity = suggestion
dotnet_diagnostic.CS0660.severity = suggestion
dotnet_diagnostic.CS0661.severity = suggestion
dotnet_diagnostic.CS0693.severity = suggestion
dotnet_diagnostic.CS8600.severity = suggestion
dotnet_diagnostic.CS8601.severity = suggestion
dotnet_diagnostic.CS8602.severity = suggestion
dotnet_diagnostic.CS8603.severity = suggestion
dotnet_diagnostic.CS8604.severity = suggestion
dotnet_diagnostic.CS8605.severity = suggestion
dotnet_diagnostic.CS8618.severity = suggestion
dotnet_diagnostic.CS8619.severity = suggestion
dotnet_diagnostic.CS8625.severity = suggestion
dotnet_diagnostic.CS8629.severity = suggestion
dotnet_diagnostic.CS8764.severity = suggestion
dotnet_diagnostic.CS8765.severity = suggestion
dotnet_diagnostic.SYSLIB0014.severity = suggestion
